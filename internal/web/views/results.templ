package views

import (
	"duplicate-cleaner/internal/model"
	"fmt"
)

templ Results(groups []model.DuplicateGroup, directDelete bool) {
	@Layout("扫描结果") {
		if len(groups) == 0 {
			<!-- 无重复文件 -->
			<div class="bg-white rounded-lg shadow-sm p-8 border border-gray-200 text-center">
				<div class="text-5xl mb-4">✅</div>
				<h2 class="text-xl font-semibold text-gray-800 mb-2">未发现重复文件</h2>
				<p class="text-sm text-gray-500 mb-6">所有文件都是唯一的，无需清理。</p>
				<a href="/" class="inline-block px-6 py-2.5 bg-purple-600 text-white rounded-lg hover:bg-purple-700 text-sm font-medium">
					← 返回首页
				</a>
			</div>
		} else {
		<div x-data="resultForm()" class="space-y-6">
			<!-- 统计信息 -->
			<div class="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
				<div class="flex items-center justify-between">
					<div>
						<h2 class="text-lg font-semibold text-gray-800">📋 扫描结果</h2>
						<p class="text-sm text-gray-500 mt-1">
							发现
							<span class="font-semibold text-purple-600">{ fmt.Sprintf("%d", len(groups)) }</span>
							组重复文件
						</p>
					</div>
					<div class="flex gap-2">
						<button
							@click="selectAllKeepFirst()"
							class="px-3 py-1.5 text-sm bg-amber-50 text-amber-700 rounded-md hover:bg-amber-100 border border-amber-200"
						>
							每组保留第一个
						</button>
						<button
							@click="selectAllFiles()"
							class="px-3 py-1.5 text-sm bg-gray-50 text-gray-700 rounded-md hover:bg-gray-100 border border-gray-200"
						>
							全选
						</button>
						<button
							@click="deselectAll()"
							class="px-3 py-1.5 text-sm bg-gray-50 text-gray-700 rounded-md hover:bg-gray-100 border border-gray-200"
						>
							取消全选
						</button>
					</div>
				</div>
			</div>

			<!-- 重复文件组 -->
			for i, group := range groups {
				<div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden" data-group={ fmt.Sprintf("%d", i) }>
					<div class="bg-blue-50 px-6 py-3 border-b border-blue-100">
						<h3 class="font-semibold text-blue-800">
							重复组 #{ i + 1 }
							<span class="text-xs text-blue-500 ml-2">({ len(group.Files) } 个文件)</span>
						</h3>
						<p class="text-xs text-blue-400 mt-0.5">哈希: { group.Hash }</p>
					</div>
					<div class="divide-y divide-gray-100">
						for j, file := range group.Files {
							<label class="flex items-center gap-3 px-6 py-3 hover:bg-gray-50 cursor-pointer">
								<input
									type="checkbox"
									class="rounded text-red-600 focus:ring-red-500 delete-checkbox"
									data-group={ fmt.Sprintf("%d", i) }
									data-index={ fmt.Sprintf("%d", j) }
									value={ file.Path }
									@change="toggleFile($event.target.value)"
								/>
								<div class="flex-1 min-w-0">
									<p class="text-sm text-gray-800 truncate" title={ file.Path }>{ file.Path }</p>
								</div>
								<span class="text-xs text-amber-600 font-medium whitespace-nowrap">
									{ formatFileSize(file.Size) }
								</span>
							</label>
						}
					</div>
				</div>
			}

			<!-- 删除按钮 -->
			<div class="sticky bottom-4" x-show="selectedFiles.length > 0">
				<div class="bg-white rounded-lg shadow-lg p-4 border border-gray-200 flex items-center justify-between">
					<div>
						<p class="text-sm text-gray-700">
							已选择 <span class="font-bold text-red-600" x-text="selectedFiles.length"></span> 个文件待删除
						</p>
						if directDelete {
							<p class="text-xs text-red-500 mt-1">⚠️ 直接删除模式，文件删除后无法恢复</p>
						} else {
							<p class="text-xs text-gray-500 mt-1">文件将移到回收站</p>
						}
					</div>
					<div class="flex gap-3">
						<a href="/" class="px-4 py-2 text-sm text-gray-600 hover:text-gray-800">返回</a>
						<button
							@click="confirmDelete()"
							class="px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 text-sm font-medium"
						>
							🗑️ 删除选中的文件
						</button>
					</div>
				</div>
			</div>

			<!-- 无选中时的返回按钮 -->
			<div class="text-center" x-show="selectedFiles.length === 0">
				<a href="/" class="text-sm text-purple-600 hover:text-purple-800 hover:underline">← 返回首页</a>
			</div>

			<!-- 确认弹窗 -->
			<div
				x-show="showConfirm"
				x-cloak
				class="fixed inset-0 bg-black/50 flex items-center justify-center z-50"
				@click.self="showConfirm = false"
			>
				<div class="bg-white rounded-xl shadow-2xl p-6 max-w-md w-full mx-4">
					<h3 class="text-lg font-bold text-gray-800 mb-2">⚠️ 确认删除</h3>
					<p class="text-sm text-gray-600 mb-4">
						确定要删除 <span class="font-bold text-red-600" x-text="selectedFiles.length"></span> 个文件吗？
						if directDelete {
							<span class="text-red-600 font-medium">此操作不可恢复！</span>
						} else {
							<span>文件将移到回收站。</span>
						}
					</p>
					<div class="flex gap-3 justify-end">
						<button
							@click="showConfirm = false"
							class="px-4 py-2 text-sm text-gray-600 hover:text-gray-800 rounded-lg border border-gray-300"
						>
							取消
						</button>
						<button
							@click="doDelete()"
							:disabled="deleting"
							class="px-4 py-2 text-sm bg-red-600 text-white rounded-lg hover:bg-red-700 disabled:bg-gray-400"
						>
							<span x-show="!deleting">确认删除</span>
							<span x-show="deleting">删除中...</span>
						</button>
					</div>
				</div>
			</div>

			<!-- 删除结果 -->
			<div x-show="deleteResult" x-cloak class="bg-white rounded-lg shadow-sm p-6 border border-gray-200">
				<template x-if="deleteResult">
					<div>
						<div x-show="deleteResult.success > 0" class="text-green-700 mb-2">
							✅ 成功删除 <span x-text="deleteResult.success"></span> 个文件
						</div>
						<div x-show="deleteResult.fail > 0" class="text-red-700">
							❌ 删除失败 <span x-text="deleteResult.fail"></span> 个文件
						</div>
						<div class="mt-4">
							<a href="/" class="text-sm text-purple-600 hover:text-purple-800 hover:underline">← 返回首页</a>
						</div>
					</div>
				</template>
			</div>
		</div>

		<script>
			function resultForm() {
				return {
					selectedFiles: [],
					showConfirm: false,
					deleting: false,
					deleteResult: null,

					toggleFile(path) {
						const idx = this.selectedFiles.indexOf(path);
						if (idx >= 0) {
							this.selectedFiles.splice(idx, 1);
						} else {
							this.selectedFiles.push(path);
						}
					},

					selectAllKeepFirst() {
						this.selectedFiles = [];
						const checkboxes = document.querySelectorAll('.delete-checkbox');
						const groupMap = {};
						checkboxes.forEach((cb) => {
							const g = cb.dataset.group;
							if (!groupMap[g]) groupMap[g] = [];
							groupMap[g].push(cb);
						});
						// 每组选中除第一个以外的所有文件
						for (const g in groupMap) {
							const cbs = groupMap[g];
							for (let i = 0; i < cbs.length; i++) {
								if (i === 0) {
									cbs[i].checked = false;
								} else {
									cbs[i].checked = true;
									this.selectedFiles.push(cbs[i].value);
								}
							}
						}
					},

					selectAllFiles() {
						this.selectedFiles = [];
						document.querySelectorAll('.delete-checkbox').forEach((cb) => {
							cb.checked = true;
							this.selectedFiles.push(cb.value);
						});
					},

					deselectAll() {
						this.selectedFiles = [];
						document.querySelectorAll('.delete-checkbox').forEach((cb) => {
							cb.checked = false;
						});
					},

					confirmDelete() {
						this.showConfirm = true;
					},

					async doDelete() {
						this.deleting = true;
						try {
							const resp = await fetch('/api/delete', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify({ paths: this.selectedFiles }),
							});
							const data = await resp.json();
							this.showConfirm = false;
							// 删除成功后重新加载结果页，列表会自动更新
							if (data.success > 0) {
								window.location.href = '/results';
							} else {
								this.deleteResult = data;
								this.deleting = false;
							}
						} catch (e) {
							alert('删除失败: ' + e.message);
							this.deleting = false;
						}
					},
				};
			}
		</script>
		}
	}
}
